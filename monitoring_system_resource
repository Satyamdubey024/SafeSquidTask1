system_load() {
    echo "+------------------------------------------+"
    echo "|              System Load                 |"
    echo "+------------------------------------------+"

    # 1. Load Average
    loadavg=$(uptime | awk -F'load average: ' '{print $2}')
    echo "| Load Average (1/5/15 min): $loadavg |"

    # 2. CPU Usage Breakdown
    # From /proc/stat: user, nice, system, idle, iowait, irq, softirq
    read cpu user nice system idle iowait irq softirq steal guest < /proc/stat

    total=$((user + nice + system + idle + iowait + irq + softirq))
    total_idle=$((idle + iowait))

    user_p=$(awk "BEGIN {printf \"%.1f\", ($user / $total) * 100}")
    system_p=$(awk "BEGIN {printf \"%.1f\", ($system / $total) * 100}")
    idle_p=$(awk "BEGIN {printf \"%.1f\", ($total_idle / $total) * 100}")
    iowait_p=$(awk "BEGIN {printf \"%.1f\", ($iowait / $total) * 100}")

    echo "| CPU Usage:                               |"
    echo "|   User:   $user_p%   System: $system_p%   Idle: $idle_p%   |"
    echo "|   IOWait: $iowait_p%                            |"
    echo "+------------------------------------------+"
}

