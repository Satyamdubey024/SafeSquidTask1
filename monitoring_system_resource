#!/bin/bash


top_apps(){

echo "+--------------------------------+"
    echo "| Top Processes (CPU & Mem) |"
echo "+--------------------------------+"    
echo "|--------|----------------------|----------|-------------|"
printf "| %-6s | %-20s | %-8s | %-10s |\n" "PID" "Process Name" "CPU (%)" "Memory (%)"
echo "|--------|----------------------|----------|-------------|"

ps -eo pid,comm,%cpu,%mem --sort=-%cpu,-%mem | head -n 11 | tail -n +2 | while read pid comm cpu mem
do
    printf "| %-6s | %-20s | %-8s | %-10s |\n" "$pid" "$comm" "$cpu" "$mem"
done



 echo "+--------------------------------+"

}
##top_apps

##network monitoring


network_monitoring() {
    echo "+-----------------------------------------------+"
    echo "|               Network Monitoring              |"
    echo "+-----------------------------------------------+"

    # 1. Concurrent connections
    connections=$(ss -tun | tail -n +2 | wc -l)

    # 2. Total packet drops (RX)
    rx_drops=$(cat /proc/net/dev | awk '/:/ {print $1, $2, $4}' | grep -v "lo" | awk '{sum+=$3} END {print sum}')

    # 3. Data in/out in MB
    rx_bytes=$(cat /proc/net/dev | grep -v lo | awk '{sum+=$2} END {print sum}')
    tx_bytes=$(cat /proc/net/dev | grep -v lo | awk '{sum+=$10} END {print sum}')

    rx_mb=$(awk "BEGIN {printf \"%.2f\", $rx_bytes / 1024 / 1024}")
    tx_mb=$(awk "BEGIN {printf \"%.2f\", $tx_bytes / 1024 / 1024}")

    echo "| Active Connections: $connections     | Packet Drops: $rx_drops        |"
    echo "| Data In: ${rx_mb}MB        | Data Out: ${tx_mb}MB       |"
    echo "+-----------------------------------------------+"
}

