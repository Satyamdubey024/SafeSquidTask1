disk_usage() {
    echo "+--------------------------------------+"
    echo "|            Disk Usage                |"
    echo "+--------------------------------------+"
    printf "| %-20s | %-6s | %-6s |\n" "Mount Point" "Used" "Use%"

    df -h --output=target,used,pcent | tail -n +2 | while read -r target used percent; do
        usage_num=$(echo "$percent" | tr -d '%')
        if [ "$usage_num" -ge 80 ]; then
            printf "| %-20s | %-6s | \e[31m%-6s\e[0m |\n" "$target" "$used" "$percent"
        else
            printf "| %-20s | %-6s | %-6s |\n" "$target" "$used" "$percent"
        fi
    done

    echo "+--------------------------------------+"
}

