#!/bin/bash

process_monitoring() {
    echo "+-----------------------------------------------+"
    echo "|               Process Monitoring              |"
    echo "+-----------------------------------------------+"

    # Total number of running processes
    total_procs=$(ps -e --no-headers | wc -l)
    echo "| Total Active Processes: $total_procs"

    echo "| Top 5 by CPU Usage:                         |"
    echo "| PID   USER     %CPU  %MEM  COMMAND          |"
    ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -n 6 | tail -n 5 | awk '{printf "| %-5s %-8s %-5s %-5s %-15s |\n", $1, $2, $3, $4, $5}'

    echo "| Top 5 by Memory Usage:                      |"
    echo "| PID   USER     %MEM  %CPU  COMMAND          |"
    ps -eo pid,user,%mem,%cpu,comm --sort=-%mem | head -n 6 | tail -n 5 | awk '{printf "| %-5s %-8s %-5s %-5s %-15s |\n", $1, $2, $3, $4, $5}'

    echo "+-----------------------------------------------+"
}

