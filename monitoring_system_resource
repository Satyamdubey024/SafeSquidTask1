if [ $# -eq 0 ]; then
    while true; do
        clear
        echo "========= Proxy Server Resource Dashboard ========="
        top_apps
	network_monitoring
	disk_usage
	system_load
        memory_usage
        process_monitoring
        service_monitoring
        echo "==================================================="
           sleep 5       
    done

# If arguments are provided, show selected sections only once
else
    while [ $# -gt 0 ]; do
        case "$1" in
         
            -memory) memory_usage ;;
            -disk) disk_usage ;;
            -network) network_monitoring ;;
            -process) process_monitoring ;;
            -services) service_monitoring ;;
            -topapps) top_apps ;;
	    -sysload) system_load ;;
            -all)
                top_apps
                memory_usage
                cpu_load
                disk_usage
                network_monitoring
                process_monitoring
                service_monitoring ;;
            *)
                echo "Unknown option: $1"
                echo "Available options: -topapps -network -disk -sysload -memory -process -services -all"
                ;;
        esac
        shift
    done
fi



